{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "lifelink-india",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifelink-prod",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "SET_ME",
    "FIREBASE_WEB_API_KEY": "SET_ME",
    "FIREBASE_AUTH_DOMAIN": "SET_ME",
    "FIREBASE_APP_ID": "SET_ME"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
